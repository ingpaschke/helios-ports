Subject: Wait for native X pipes and module channels together

diff --git a/modules/FvwmPager/FvwmPager.c b/modules/FvwmPager/FvwmPager.c
index 5aa933440f104ed9be43764d1100b5f5f7e56acb..ea8f89b495f34e0c6d1b5dcbf1041fa7f8a34d04 100644
--- a/modules/FvwmPager/FvwmPager.c
+++ b/modules/FvwmPager/FvwmPager.c
@@ -727,15 +727,9 @@ int My_XNextEvent(Display *dpy, XEvent *event)
   FD_SET(fd[1],&in_fdset);
   
 {
-    struct hu_pollfd ready[2];
-    int result;
-    ready[0].fd=x_fd; ready[0].events=HU_POLLIN;
-    ready[1].fd=fd[1]; ready[1].events=HU_POLLIN;
-    result=hu_poll(ready,2,-1);
-    FD_ZERO(&in_fdset);
-    if (result<0) { if(errno!=EINTR) { perror("module poll"); DeadPipe(1); } return 0; }
-    if (ready[0].revents) FD_SET(x_fd,&in_fdset);
-    if (ready[1].revents) FD_SET(fd[1],&in_fdset);
+    int width=(x_fd>fd[1]?x_fd:fd[1])+1;
+    int result=ktm_select(width,&in_fdset,0,0,0);
+    if (result<0) { if(errno!=EINTR) { perror("module select"); DeadPipe(1); } return 0; }
   }  
   
   if(FD_ISSET(x_fd, &in_fdset))
