index 6251fe6ce1d9dd99f1d02d51914d669a98a38bb2..11e276c3d6fa174462f84154cf06cf79d6e63361 100644
--- a/libs/ReadPacket.c
+++ b/libs/ReadPacket.c
@@ -1,57 +1,19 @@
 #include <stdio.h>
-#include <stdlib.h>
 #include "fvwmlib.h"
 #include "../fvwm/module.h"
-
-/************************************************************************
- * 
- * Reads a single packet of info from fvwm. Prototype is:
- * unsigned long header[3];
- * unsigned long *body;
- * int fd[2];
- * void DeadPipe(int nonsense); /* Called if the pipe is no longer open 
- *
- * ReadFvwmPacket(fd[1],header, &body);
- *
- * Returns:
- *   > 0 everything is OK.
- *   = 0 invalid packet.
- *   < 0 pipe is dead. (Should never occur)
- *
- **************************************************************************/
 int ReadFvwmPacket(int fd, unsigned long *header, unsigned long **body)
 {
-  int count,total,count2,body_length;
-  char *cbody;
   extern void DeadPipe(int);
-
-  if((count = read(fd,header,3*sizeof(unsigned long))) >0)
-    {
-      if(header[0] == START_FLAG)
-	{
-	  body_length = header[2]-3;
-	  *body = (unsigned long *)
-	    safemalloc(body_length * sizeof(unsigned long));
-	  cbody = (char *)(*body);
-	  total = 0;
-	  while(total < body_length*sizeof(unsigned long))
-	    {
-	      if((count2=
-		  read(fd,&cbody[total],
-		       body_length*sizeof(unsigned long)-total)) >0)
-		{
-		  total += count2;
-		}
-	      else if(count2 < 0)
-		{
-		  DeadPipe(1);
-		}
-	    }
-	}
-      else
-	count = 0;
-    }
-  if(count <= 0)
-    DeadPipe(1);
-  return count;
+  unsigned size;
+  *body=0;
+  if (ktm_read_full(fd,header,3*sizeof(*header))<0 ||
+      header[0]!=START_FLAG || header[2]<3 || header[2]>4096) {
+    DeadPipe(1); return -1;
+  }
+  size=(header[2]-3)*sizeof(*header);
+  *body=(unsigned long *)safemalloc(size ? size : 1);
+  if (ktm_read_full(fd,*body,size)<0) {
+    free(*body); *body=0; DeadPipe(1); return -1;
+  }
+  return 3*sizeof(*header);
 }
diff --git a/libs/SendInfo.c b/libs/SendInfo.c
index bf9cfe9f5109562f7ed4d19594f1dc14281eb1e5..a4a9ad6746ae639771b3dc0c4bb1ee3de91f0f99 100644
--- a/libs/SendInfo.c
+++ b/libs/SendInfo.c
@@ -1,26 +1,15 @@
-#include <stdio.h>
-#include <ctype.h>
-
-/***********************************************************************
- *
- *  Procedure:
- *	SendInfo - send a command back to fvwm 
- *
- ***********************************************************************/
+#include <string.h>
 void SendInfo(int *fd,char *message,unsigned long window)
 {
-  int w;
-
-  if(message != NULL)
-    {
-      write(fd[0],&window, sizeof(unsigned long));
-      w=strlen(message);
-      write(fd[0],&w,sizeof(int));
-      write(fd[0],message,w);
-
-      /* keep going */
-      w=1;
-      write(fd[0],&w,sizeof(int));
-    }
+  char frame[sizeof(unsigned long)+2*sizeof(int)+255];
+  int length, cont=1, offset=0;
+  extern void DeadPipe(int);
+  if (!message) return;
+  length=strlen(message);
+  if (length>255) { DeadPipe(1); return; }
+  memcpy(frame+offset,&window,sizeof(window)); offset+=sizeof(window);
+  memcpy(frame+offset,&length,sizeof(length)); offset+=sizeof(length);
+  memcpy(frame+offset,message,length); offset+=length;
+  memcpy(frame+offset,&cont,sizeof(cont)); offset+=sizeof(cont);
+  if (ktm_write_full(fd[0],frame,offset)<0) DeadPipe(1);
 }
