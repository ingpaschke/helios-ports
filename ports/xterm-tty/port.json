{
  "format": 1,
  "name": "xterm-tty",
  "version": "Helios-NG ttyserv with xterm terminal adapter",
  "upstream": {
    "kind": "git",
    "url": "https://github.com/axelmuhr/Helios-NG.git",
    "revision": "1fe8f65ee15407945e5a1a25f39f88de64de0d50",
    "subdirectory": "servers/ttyserv",
    "include": [
      "ttyserv/ttylib.c",
      "ttyserv/setterm.c",
      "ttyserv/input.c",
      "ttyserv/termcap.c",
      "ttyserv/globals.c",
      "ttyserv/ttydev.c",
      "ttyserv/terminal.c",
      "ttyserv/tty.c",
      "ttyserv/ansi.c",
      "ttyserv/ttydev.h",
      "ttyserv/tty.h",
      "devs/tpseudev.h"
    ],
    "tree_sha256": "65f5c1683d83e644acb56dd089fb0a6290123212eaacf496ad54e8abdd7ac97e"
  },
  "patches": [
    {
      "file": "01-helios.patch",
      "description": "Report terminal dimensions and deliver resize notifications",
      "sha256": "e51b654ffc18447d4db86342c218392cbf79658bc2d12428c0b3f7ceb246f0ac"
    },
    {
      "file": "02-input-backpressure.patch",
      "description": "Backpressure terminal input instead of dropping bytes during pastes",
      "sha256": "bb160f4e000721249c75ace267b49c0788beacd708ee50ab232d470ed397af09"
    },
    {
      "file": "03-ssh-shutdown.patch",
      "description": "Stop an SSH terminal task before freeing its live pseudo-terminal state",
      "sha256": "0ef8a572178b538120f28fe8da11fe56758f68c4590687f91d658e1d329b8425"
    },
    {
      "file": "04-eof-line.patch",
      "sha256": "d04e9856f5a4154d12cd417ffb6fb307777d1162945500d8afd16cbd62df7d61",
      "description": "Deliver the final cooked input line before EOF even without a newline"
    }
  ],
  "patched_tree_sha256": "0edaf910772cdda6d48ca07ee294bf2ac9540884c44cce85cb3b5ba4a02df16b",
  "dependencies": [],
  "build": {
    "groups": [
      {
        "name": "tty",
        "sources": [
          "${src}/ttyserv/globals.c",
          "${src}/ttyserv/termcap.c",
          "${src}/ttyserv/input.c",
          "${src}/ttyserv/terminal.c",
          "${src}/ttyserv/ansi.c",
          "${src}/ttyserv/tty.c",
          "${src}/ttyserv/ttydev.c"
        ],
        "flags": [
          "-D_BSD",
          "-D__HELIOS",
          "-D__TRAN",
          "-D__HELIOSTRAN"
        ],
        "compiler": "hcc",
        "includes": [
          "${sdk}/include",
          "${src}/ttyserv",
          "${src}/devs"
        ]
      },
      {
        "name": "ssh-tty",
        "sources": [
          "${src}/ttyserv/globals.c",
          "${src}/ttyserv/termcap.c",
          "${src}/ttyserv/input.c",
          "${src}/ttyserv/terminal.c",
          "${src}/ttyserv/ansi.c",
          "${src}/ttyserv/tty.c",
          "${src}/ttyserv/ttydev.c"
        ],
        "flags": [
          "-D_BSD",
          "-D__HELIOS",
          "-D__TRAN",
          "-D__HELIOSTRAN",
          "-DSSH_TTY"
        ],
        "compiler": "hcc",
        "includes": [
          "${sdk}/include",
          "${src}/ttyserv",
          "${src}/devs"
        ]
      }
    ],
    "targets": [
      {
        "name": "xterm-ttyserv",
        "type": "executable",
        "groups": [
          "tty"
        ],
        "libraries": [
          "${sdk}/lib/bsd.lib",
          "${sdk}/lib/c.lib",
          "${sdk}/lib/helios.lib",
          "${runtime}"
        ],
        "output": "${work}/xterm-ttyserv",
        "heap": 4000,
        "start": "${sdk}/lib/cstart.o",
        "objects": [
          "${sdk}/lib/servlib.def"
        ]
      },
      {
        "name": "ssh-tty",
        "type": "executable",
        "groups": [
          "ssh-tty"
        ],
        "libraries": [
          "${sdk}/lib/bsd.lib",
          "${sdk}/lib/c.lib",
          "${sdk}/lib/helios.lib",
          "${runtime}"
        ],
        "output": "${work}/ssh-tty",
        "heap": 4000,
        "start": "${sdk}/lib/cstart.o",
        "objects": [
          "${sdk}/lib/servlib.def"
        ]
      }
    ],
    "install": [
      {
        "type": "copy",
        "source": "${work}/xterm-ttyserv",
        "destination": "${stage}/lib/xterm-ttyserv"
      },
      {
        "type": "copy",
        "source": "${work}/ssh-tty",
        "destination": "${stage}/lib/ssh-tty"
      },
      {
        "type": "copy",
        "source": "${work}/xterm-ttyserv",
        "destination": "${stage}/lib/xttyserv"
      }
    ]
  }
}
