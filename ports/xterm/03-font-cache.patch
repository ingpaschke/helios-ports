diff --git a/fontutils.h b/fontutils.h
index 90d1caf432c2f0b6d6ffb2e5d6692dc8b5817c7f..de2bedd9911a207262c038390024ea822f6b960c 100644
--- a/fontutils.h
+++ b/fontutils.h
@@ -89,13 +89,21 @@ extern void xtermUpdateFontInfo (XtermWidget /* xw */, Bool /* doresize */);
 extern char *xtermSpecialFont (XTermDraw * /* params */);
 #endif
 
+#ifdef helios
+#define FontHasCharMetrics(fs) helios_font_has_metrics(fs)
+#define FontCharMetric(fs,n) ((XCharStruct *)(void *)helios_font_char(fs,n))
+#else
+#define FontHasCharMetrics(fs) ((fs)->per_char != NULL)
+#define FontCharMetric(fs,n) (&(fs)->per_char[n])
+#endif
+
 #define FontLacksMetrics(font) \
 	((font)->fs != NULL \
-	 && ((font)->fs->per_char == NULL))
+	 && (!FontHasCharMetrics((font)->fs)))
 
 #define FontIsIncomplete(font) \
 	((font)->fs != NULL \
-	 && (font)->fs->per_char != NULL \
+	 && FontHasCharMetrics((font)->fs) \
 	 && !(font)->fs->all_chars_exist)
 
