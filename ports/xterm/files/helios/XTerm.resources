! Native Helios terminal defaults; bitmap glyphs are rendered by the X server.
*VT100.utf8: 0
*VT100.utf8Fonts: true
*VT100.font: -misc-fixed-medium-r-normal--18-120-100-100-c-90-iso10646-1
*VT100.boldFont: -misc-fixed-bold-r-normal--18-120-100-100-c-90-iso10646-1
*VT100.wideFont: -misc-fixed-medium-r-normal-ja-18-120-100-100-c-180-iso10646-1
*VT100.wideBoldFont: -misc-fixed-medium-r-normal-ja-18-120-100-100-c-180-iso10646-1
*VT100.utf8Fonts.font: -misc-fixed-medium-r-normal--18-120-100-100-c-90-iso10646-1
*VT100.utf8Fonts.boldFont: -misc-fixed-bold-r-normal--18-120-100-100-c-90-iso10646-1
*VT100.utf8Fonts.wideFont: -misc-fixed-medium-r-normal-ja-18-120-100-100-c-180-iso10646-1
*VT100.utf8Fonts.wideBoldFont: -misc-fixed-medium-r-normal-ja-18-120-100-100-c-180-iso10646-1
*VT100.foreground: #182c30
*VT100.background: #ffffed
*VT100.saveLines: 1000
*VT100.scrollBar: true
*VT100.metaSendsEscape: true
*VT100.altSendsEscape: true
