  },
  "patches": [
    {
      "file": "01-headers.patch",
      "sha256": "d7eb6e14b4035d6b73a9a91a212ae8aaf6188b741f2c8825d614c088859aaf36",
      "description": "Use standard C allocation and string declarations on Helios"
    },
    {
      "file": "02-abi.patch",
      "sha256": "9bcbc943597fa6dc21511e80bb5c9adf3ef78b1a440134d133de90c8fa0eff85",
      "description": "Support the Helios C ABI, X11R4 headers and native terminal attributes"
    },
    {
      "file": "03-notifier.patch",
      "sha256": "cc8fa35bf7c7d969b3909b03c2715be92515fb707aae599534c53a309cfafe7a",
      "description": "Use native readiness and channels without interposing on libc or requiring Unix system calls"
    },
    {
      "file": "04-file-filter.patch",
      "sha256": "9613c36bab510bbb39b724a10e627c6659f704fd8636a76d2955be80a3cd4334",
      "description": "Use the existing Helios regular-expression engine for file chooser filters"
    },
    {
      "file": "05-terminal.patch",
      "sha256": "02dbe9793c567c5a10396338f3dc7912c4207d7b94e7630a41601b238a72ad9b",
      "description": "Run terminal clients through the native Helios terminal service"
    },
    {
      "file": "06-data.patch",
      "sha256": "03b25364ca7b91a79c2c0b980430e5f4f81801048073c1e7dc3726fab7e4df0b",
      "description": "Declare shared toolkit data once for the native Helios linker"
    },
    {
      "file": "07-system.patch",
      "sha256": "95ac3de2477a2241496e9019a7e00cb58920335c434175014d114f1b6ed5f7e8",
      "description": "Use X11R4 resource allocation and supported native libc interfaces"
    },
    {
      "file": "08-paths.patch",
      "sha256": "126e1b3dbfa7530af417df9f23ad54322b55b092da3307a7e1753948101d23be",
      "description": "Place temporary files and editor resources in the Helios filesystem"
    },
    {
      "file": "09-packet.patch",
      "sha256": "e39072159ae10aa82b4b4ba7050094eb4e02416f0c8d1e3a4a0f7e69d9d4400c",
      "description": "Read native terminal packets atomically instead of splitting their headers and payloads"
    },
    {
      "file": "10-notify-header.patch",
      "sha256": "4d1ac2db2e28512228e4118b8f0fb6a74f855678272effd9e8e86169c1c0e909",
      "description": "Expose the native interval-timer types to XView applications"
    },
    {
      "file": "11-line-editing.patch",
      "sha256": "63acec6f5a886f9794d536b4fba299b10b2f301487a92b2ed2f8f5d14e138f2d",
      "description": "Keep cmdtool line editing in the native terminal server without Unix record mode"
    },
    {
      "file": "12-file-identity.patch",
      "sha256": "043a3ba5d81306fff1be04f82b8ce60197497d2882f88828e8baf974e7965b07",
      "description": "Compare resolved native stream names instead of unavailable inode numbers when saving backups"
    },
    {
      "file": "13-filter-spawn.patch",
      "sha256": "faebcf3afc12e5abeade5a50b3f2835dfd9dce67efff8b89fd8d5e15109813ca",
      "description": "Launch editor filters with native channels and descriptor actions instead of shared vfork state"
    },
    {
      "file": "14-editor-resources.patch",
      "sha256": "30eb0d4d6674ce701f594d07ac0442ea11822a3254a8078e2384367c0b38c8c5",
      "description": "Find native editor filters and close menu-file probes"
    },
    {
      "file": "15-public-platform.patch",
      "sha256": "0667a1ff60d13b9eb975b296c839f7bcad2624f3320a1b5ec365b33bcb45fefc",
      "description": "Select the native ABI from public headers without requiring a SunOS build flag"
    },
    {
      "file": "16-descriptor-bounds.patch",
      "sha256": "b04d61009496e7af023a464c3959515105c8738832cea56f046b4c1cbd3ecde4",
      "description": "Keep descriptors outside notifier masks from corrupting memory"
    },
    {
      "file": "17-clock-allocation.patch",
      "sha256": "0cbca38dccc2c41c247c0994a7b06a9bf2f35135ccac3eacfec2e3520d7767bd",
      "description": "Handle clock startup allocation failures before accessing its state"
    },
    {
      "file": "18-terminal-buffers.patch",
      "sha256": "676b34de3e59a68112827b42e4c783b8352b4a695264b04a3600e6b727d04652",
      "description": "Allocate login command names and bound terminal frame and icon labels"
    },
    {
      "file": "19-event-lifetime.patch",
      "sha256": "7fcc5b5720c99bb257f822aa05aa31c17c18eb6f62d46fe5028da9cb86c14955",
      "description": "Translate caller-owned events without returning stack-local storage"
    },
    {
      "file": "20-empty-directory-sort.patch",
      "sha256": "3945150be61736e893eb14b9176343e7f15be9a85fbf74bd31ca591a83361790",
      "description": "Do not pass an empty row list to qsort in the file chooser"
    }
  ],
  "patched_tree_sha256": "82d794ff55e493d6eefa66481fa5720fcf8b1290ad24ece8780c2f0a02dd2620",
