Subject: Use native task spawning, readiness waits and signal handling

diff --git a/clients/olwm/events.c b/clients/olwm/events.c
index 974c1b6c1db34a3a01f885beaaa86daf46649bcc..b27c454593c4fc962be920ab6fa5b627082cdf92 100644
--- a/clients/olwm/events.c
+++ b/clients/olwm/events.c
@@ -304,7 +304,11 @@ XEvent *event;
 	    FD_ZERO(&xset);
 	    FD_SET(fd,&xset);
 
-	    ready = select(fd+1,&rdset,&wrset,&xset,&polltime);
+	    #ifdef __HELIOS
+            ready = olwm_select(fd+1,&rdset,&wrset,&xset,&polltime);
+#else
+            ready = select(fd+1,&rdset,&wrset,&xset,&polltime);
+#endif
 
 	    gettimeofday(&polltime,NULL);
 	    if ((timeoutFunc != NULL) &&
@@ -586,7 +590,11 @@ AwaitEvents(dpy, timeout)
     while (1) {
 	FD_ZERO(&rfds);
 	FD_SET(ConnectionNumber(dpy), &rfds);
-	s = select(ConnectionNumber(dpy)+1, &rfds, NULL, NULL, timeout);
+	#ifdef __HELIOS
+        s = olwm_select(ConnectionNumber(dpy)+1, &rfds, NULL, NULL, timeout);
+#else
+        s = select(ConnectionNumber(dpy)+1, &rfds, NULL, NULL, timeout);
+#endif
 	if (s == 0) {
 	    /* we timed out without getting anything */
 	    return False;
