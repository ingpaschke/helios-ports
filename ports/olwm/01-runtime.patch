diff --git a/clients/olwm/olwm.c b/clients/olwm/olwm.c
index 055a86809d1a66a3c6f927cbc76ba847d88c769a..f8606293044f4a4e7a315d753ee26e25374cb462 100644
--- a/clients/olwm/olwm.c
+++ b/clients/olwm/olwm.c
@@ -598,7 +598,11 @@ int
 RestartOLWM()
 {
     cleanup();
+#ifdef __HELIOS
+    olwm_restart(argVec);
+#else
     execvp(argVec[0], argVec);
+#endif
     ErrorGeneral("cannot restart");
     /*NOTREACHED*/
 }
@@ -634,7 +638,7 @@ handleChildSignal()
 void
 ReapChildren()
 {
-#if defined(SYSV) || defined(__linux__)
+#if defined(SYSV) || defined(__linux__) || defined(__HELIOS)
         pid_t pid;
         int status;
 #else
@@ -645,7 +649,12 @@ ReapChildren()
 
 	if (!deadChildren)
 		return;
-#if defined(SYSV) || defined(__linux__)
+#ifdef __HELIOS
+        sigset_t blocked, previous;
+        sigemptyset(&blocked);
+        sigaddset(&blocked, SIGCHLD);
+        sigprocmask(SIG_BLOCK, &blocked, &previous);
+#elif defined(SYSV) || defined(__linux__)
 	sighold(SIGCHLD);
 #else
 	oldmask = sigblock(sigmask(SIGCHLD));
@@ -655,7 +664,7 @@ ReapChildren()
 
 	while (1) {
 
-#if defined(SYSV) || defined(__linux__)
+#if defined(SYSV) || defined(__linux__) || defined(__HELIOS)
                 pid = waitpid(-1, &status, WNOHANG);
 #else
                 pid = wait3(&status, WNOHANG, (struct rusage *)0);
@@ -682,7 +691,9 @@ ReapChildren()
 
 	deadChildren = False;
 
-#if defined(SYSV) || defined(__linux__)
+#ifdef __HELIOS
+        sigprocmask(SIG_SETMASK, &previous, NULL);
+#elif defined(SYSV) || defined(__linux__)
 	sigrelse(SIGCHLD);
 #else
         (void) sigsetmask(oldmask);
