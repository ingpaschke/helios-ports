Subject: Preserve subsecond event deadlines and use native timed waits

diff --git a/clients/olwm/events.c b/clients/olwm/events.c
index b27c454593c4fc962be920ab6fa5b627082cdf92..d9e82d6bf7794b488b3a518a83f7bcb76ee5a4c1 100644
--- a/clients/olwm/events.c
+++ b/clients/olwm/events.c
@@ -295,8 +295,12 @@ XEvent *event;
 		continue;
 	    }
 
-	    polltime.tv_sec = timeoutNext.tv_sec - polltime.tv_sec;
-	    polltime.tv_usec = 0;
+            polltime.tv_sec = timeoutNext.tv_sec - polltime.tv_sec;
+            polltime.tv_usec = timeoutNext.tv_usec - polltime.tv_usec;
+            if (polltime.tv_usec < 0) {
+                --polltime.tv_sec;
+                polltime.tv_usec += 1000000;
+            }
 
 	    FD_ZERO(&rdset);
 	    FD_SET(fd,&rdset);
diff --git a/clients/olwm/usleep.c b/clients/olwm/usleep.c
index 6408f0e44b50787a3f515be3b2ce8ca70019d582..f150b43429e94811c8543cde456130de94deb317 100644
--- a/clients/olwm/usleep.c
+++ b/clients/olwm/usleep.c
@@ -76,6 +76,11 @@ olwm_usleep(usec)
 	setitimer(ITIMER_REAL, &old, (struct itimerval *)0);
 	return 0;
 
+#elif defined(__HELIOS)
+        struct timeval timeout;
+        timeout.tv_sec = usec / 1000000;
+        timeout.tv_usec = usec % 1000000;
+        return olwm_select(0, NULL, NULL, NULL, &timeout);
 #else /* SYSV */
 
 	return usleep(usec);
