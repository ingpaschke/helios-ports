Subject: Provide the Helios terminal and curses adapter

diff --git a/src/curses/ux_init.c b/src/curses/ux_init.c
index f4a52ce6ba0856e27f5514e97179050608f31b83..b8dbc64046f9e3a9608b8e4ef2a9557b097d2bca 100644
--- a/src/curses/ux_init.c
+++ b/src/curses/ux_init.c
@@ -42,7 +42,11 @@
 #include <curses.h>
 #endif
 
-#ifndef WIN32
+/* Helios: <termios.h> redefines ECHO (termios c_lflag value) over the
+ * <sgtty.h> one that the BSD curses noecho() macro uses, so noecho()
+ * would clear the wrong bit and the console would echo every key.
+ * Nothing here needs termios. */
+#if !defined(WIN32) && !defined(HELIOS_PORT)
 #include <termios.h>
 #endif
 
@@ -224,7 +228,7 @@ void os_process_arguments (int argc, char *argv[])
 
 	zoptarg = NULL;
 
-#if !defined(WIN32) && !defined(__HAIKU__)
+#if !defined(WIN32) && !defined(__HAIKU__) && !defined(HELIOS_PORT)
 	if ((getuid() == 0) || (geteuid() == 0)) {
 		printf("I won't run as root!\n");
 		os_quit(EXIT_FAILURE);
@@ -238,8 +242,12 @@ void os_process_arguments (int argc, char *argv[])
 #endif
 
 	if ((home = getenv(HOMEDIR)) == NULL) {
+#ifdef HELIOS_PORT
+		home = ".";	/* only used to find .frotzrc */
+#else
 		printf("Hard drive on fire!\n");
 		os_quit(EXIT_FAILURE);
+#endif
 	}
 
 
@@ -255,7 +263,9 @@ void os_process_arguments (int argc, char *argv[])
 
 
 /*	if (signal(SIGWINCH, SIG_IGN) != SIG_IGN) */
+#ifdef SIGWINCH
 	signal(SIGWINCH, sigwinch_handler);
+#endif
 
 	if (signal(SIGINT, SIG_IGN) != SIG_IGN)
 		signal(SIGINT, sigint_handler);
@@ -301,6 +311,12 @@ void os_process_arguments (int argc, char *argv[])
 	p = strrchr(f_setup.story_name, '.');
 	if ( p != NULL )
 		*p = '\0';  /* extension removed */
+#ifdef HELIOS_PORT
+	/* Helios on the ATW800 keeps files on a GEMDOS disk (8.3 names):
+	 * keep default save/script/record names 8.3-safe. */
+	if (strlen(f_setup.story_name) > 8)
+		f_setup.story_name[8] = '\0';
+#endif
 
 	/* Create nice default file names */
 	f_setup.script_name = malloc((strlen(f_setup.story_name) + strlen(EXT_SCRIPT) + 1) * sizeof(char));
@@ -482,8 +498,10 @@ void os_init_screen (void)
 	setlocale(LC_ALL, "");
 #endif
 
+#ifndef HELIOS_PORT
 	if (getenv("ESCDELAY") == NULL)
 		setenv("ESCDELAY", "50", 1);
+#endif
 
 	if (initscr() == NULL) {    /* Set up curses */
 		os_fatal("Unable to initialize curses. Maybe your $TERM setting is bad.");
@@ -498,7 +516,7 @@ void os_init_screen (void)
 	scrollok(stdscr, FALSE);	/* No scrolling unless explicitly asked for */
 
 	/* It's nice to know what terminal we have to work with. */
-	u_setup.term = strdup(getenv("TERM"));
+	u_setup.term = getenv("TERM") ? strdup(getenv("TERM")) : NULL;
 
 	if (z_header.version == V3 && f_setup.tandy != 0)
 		z_header.config |= CONFIG_TANDY;
@@ -630,8 +648,15 @@ void os_quit(int status)
 	os_stop_sample(0);
 	ux_blorb_stop();
 	if (u_setup.curses_active) {
+#ifdef HELIOS_PORT
+		/* BSD scroll() repaints every line; scroll the terminal. */
+		setscrreg(0, getmaxy(stdscr) - 1);
+		scrl(1);
+		move(getmaxy(stdscr) - 1, 0);
+#else
 		scrollok(stdscr, TRUE);
 		scroll(stdscr);
+#endif
 		refresh();
 		endwin();
 	}
@@ -701,6 +726,10 @@ FILE *os_path_open(const char *name, const char *mode)
 
 	if ( (p = getenv(PATH1) ) == NULL)
 		p = getenv(PATH2);
+#ifdef HELIOS_PORT
+	if (p == NULL)
+		p = "/helios/local/games";
+#endif
 
 	if (p != NULL) {
 		fp = pathopen(name, p, mode);
@@ -1159,7 +1188,9 @@ static int geterrmode(char *value)
 static void sigwinch_handler(int UNUSED(sig))
 {
 	terminal_resized = 1;
+#ifdef SIGWINCH
 	signal(SIGWINCH, sigwinch_handler);
+#endif
 } /* sigwinch_handler */
 
 
@@ -1195,7 +1226,12 @@ void os_init_setup(void)
 			to use the same hack the MS-DOS port
 			does...keep the current style in a
 			global variable. */
+#ifdef HELIOS_PORT
+	/* Helios curses keeps standout in bit 7 of each character: no Latin-1. */
+	u_setup.plain_ascii = 1;
+#else
 	u_setup.plain_ascii = 0; /* true if user wants to disable Latin-1 */
+#endif
 	u_setup.curses_active = 0;      /* true if os_init_screen has run */
 	/* u_setup.interpreter = INTERP_DEFAULT; */
 	u_setup.current_color = 0;
diff --git a/src/curses/ux_input.c b/src/curses/ux_input.c
index 5c2e42200fa9add54a38ffc7aa9aec97342f9cd4..a822fba63db966884bbade547feb168e333e70fb 100644
--- a/src/curses/ux_input.c
+++ b/src/curses/ux_input.c
@@ -31,7 +31,9 @@
 
 #include <errno.h>
 #include <sys/time.h>
+#ifndef HELIOS_PORT
 #include <sys/select.h>
+#endif
 
 #include "ux_defines.h"
 
@@ -175,12 +177,37 @@ static int unix_read_char(int extkeys)
 #else
 	int c;
 #endif
+#ifdef HELIOS_PORT
+	int sel;
+	struct timeval tval, *t_left;
+#else
 	int sel, fd = fileno(stdin);
 	fd_set rsel;
 	struct timeval tval, *t_left, maxwait;
+#endif
 
 
 	while(1) {
+#ifdef HELIOS_PORT
+		/* No select() on the Helios console: getch() itself waits
+		 * with a timeout (src/helios/hcurses.c). */
+		os_tick();
+		refresh();
+		t_left = timeout_left(&tval) ? &tval : NULL;
+		if (t_left) {
+			long ms = tval.tv_sec * 1000L + tval.tv_usec / 1000;
+			timeout(ms > 0 ? (int)ms : 1);
+		} else
+			timeout(-1);
+		c = getch();
+		timeout(-1);
+		if (c == ERR) {
+			if (t_left)
+				return ZC_TIME_OUT;
+			continue;
+		}
+		(void)sel;
+#else
 		/* Wait with select so that we get interrupted on SIGWINCH. */
         	FD_ZERO(&rsel);
 		FD_SET(fd, &rsel);
@@ -234,6 +261,7 @@ static int unix_read_char(int extkeys)
 #else
 		c = getch();
 #endif
+#endif /* HELIOS_PORT */
 
 		/* Catch 98% of all input right here... */
 		if ((c >= ZC_ASCII_MIN && c <= ZC_ASCII_MAX) || (!u_setup.plain_ascii
diff --git a/src/curses/ux_screen.c b/src/curses/ux_screen.c
