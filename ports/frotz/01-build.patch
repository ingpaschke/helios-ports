Subject: Build the native interpreters with explicit toolchain and portability settings

diff --git a/src/common/input.c b/src/common/input.c
index ce545cc6aa17a554f4b652b1f73f56708990d62f..6a2616c2205bf56cf9ce708ccb4b876478a7a690 100644
--- a/src/common/input.c
+++ b/src/common/input.c
@@ -167,7 +167,14 @@ void z_read(void)
 		f_setup.err_report_repeat = 0;
 	}
 
-	/* Supply default arguments */
+	/* Supply default arguments.  A read with fewer than three
+	 * operands has no timeout (Z-Machine Standard 1.1, 15: read);
+	 * without this, zargs[2] keeps whatever the previous instruction
+	 * left there.  Advent's "Are you sure you want to quit?" reads
+	 * with two operands right after an instruction that left 23865,
+	 * which made it a timed read of 2386.5 seconds. */
+	if (zargc < 3)
+		zargs[2] = 0;
 	if (zargc < 4)
 		zargs[3] = 0;
 
