diff --git a/src/dumb/dinit.c b/src/dumb/dinit.c
index 21aaf30e3230d7ee002720d1520b6bd2d044eb7a..6fb07219f3d8213c75a1f12a9a2626fe1edda304 100644
--- a/src/dumb/dinit.c
+++ b/src/dumb/dinit.c
@@ -57,7 +57,7 @@ While running, enter \"\\help\" to list the runtime escape sequences.\n"
 static int user_text_width = 80;
 static int user_text_height = 24;
 static int user_random_seed = -1;
-static bool plain_ascii = FALSE;
+extern bool plain_ascii;	/* doutput.c */
 
 bool quiet_mode;
 bool do_more_prompts;
@@ -220,7 +220,7 @@ void os_process_arguments(int argc, char *argv[])
 	/* Save the story file name */
 	f_setup.story_file = strdup(argv[zoptind]);
 
-#ifdef NO_BASENAME
+#if defined(NO_BASENAME) && !defined(HELIOS_PORT)
 	f_setup.story_name = strdup(f_setup.story_file);
 #else
 	f_setup.story_name = strdup(basename(argv[zoptind]));
@@ -241,6 +241,12 @@ void os_process_arguments(int argc, char *argv[])
 	p = strrchr(f_setup.story_name, '.');
 	if ( p != NULL )
 		*p = '\0';	/* extension removed */
+#ifdef HELIOS_PORT
+	/* Helios on the ATW800 keeps files on a GEMDOS disk (8.3 names):
+	 * keep default save/script/record names 8.3-safe. */
+	if (strlen(f_setup.story_name) > 8)
+		f_setup.story_name[8] = '\0';
+#endif
 
 	/* Create nice default file names */
 	f_setup.script_name = malloc((strlen(f_setup.story_name) + strlen(EXT_SCRIPT) + 1) * sizeof(char));
@@ -385,6 +391,18 @@ FILE *os_load_story(void)
 	if (f_setup.exec_in_blorb)
 		fseek(fp, blorb_res.data.startpos, SEEK_SET);
 
+	return fp;
+#elif defined(HELIOS_PORT)
+	FILE *fp = fopen(f_setup.story_file, "rb");
+
+	/* As the curses frotz on Helios: a bare name is also looked for in
+	 * /helios/local/games. */
+	if (fp == NULL && strchr(f_setup.story_file, '/') == NULL) {
+		char path[PATH_MAX];
+
+		sprintf(path, "/helios/local/games/%.200s", f_setup.story_file);
+		fp = fopen(path, "rb");
+	}
 	return fp;
 #else
 	return fopen(f_setup.story_file, "rb");
diff --git a/src/dumb/doutput.c b/src/dumb/doutput.c
index 80716284841c5ab655c526ca8a402592d85a941d..cdae6c1c76c62fc2d86871cce8238749559add88 100644
--- a/src/dumb/doutput.c
+++ b/src/dumb/doutput.c
@@ -29,7 +29,14 @@ static bool show_line_numbers = FALSE;
 static bool show_line_types = FALSE;
 static bool show_pictures = TRUE;
 static bool visual_bell = TRUE;
-static bool plain_ascii = FALSE;
+/* Shared with dinit.c (-p); upstream 2.55 had a separate static copy in
+ * each file, so -p never reached the output code.  Helios consoles (and
+ * the ATW800's Atari character set) are not Latin-1: default to ASCII. */
+#ifdef HELIOS_PORT
+bool plain_ascii = TRUE;
+#else
+bool plain_ascii = FALSE;
+#endif
 
 static char latin1_to_ascii[] =
 	"    !   c   L   >o< Y   |   S   ''  C   a   <<  not -   R   _   "
