  "dependencies": [],
  "host_tools": [
    "make"
  ],
  "build": {
    "prepare": [
      {
        "type": "run",
        "command": [
          "make",
          "-f",
          "Makefile.helios",
          "-j${jobs}",
          "CLANG=${clang}",
          "SYSROOT=${sdk}",
          "HASMDIR=${asm_dir}"
