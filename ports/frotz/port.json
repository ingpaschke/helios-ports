{
  "format": 1,
  "name": "frotz",
  "version": "2.55",
  "upstream": {
    "kind": "archive",
    "url": "https://www.ifarchive.org/if-archive/infocom/interpreters/frotz/frotz-2.55.tar.gz",
    "filename": "frotz-2.55.tar.gz",
    "sha256": "e3d6912ff94bca724759fe59aa222c1ee23aa4d35ffa15a0b40f72f97887d871",
    "subdirectory": "frotz-2.55",
    "tree_sha256": "62999fed5369e98ee1112ce62a083d3e6bfc0d562addd777b675c1d15c0f2ea4"
  },
  "patches": [
    {
      "file": "01-build.patch",
      "description": "Build the native interpreters with explicit toolchain and portability settings",
      "sha256": "5d0dbc54d4fc290a5a0e1b076c084adf481847fba3cb65277e20542b179b298c"
    },
    {
      "file": "02-platform.patch",
      "sha256": "82a351abb557e7e9e60f1cff4973f3fda46e11e34e402535726830f22f81dd03",
      "description": "Use Helios paths and the native ncurses library"
    },
    {
      "file": "03-status-line.patch",
      "sha256": "940b993d7f75aa93271dc7c7e56d3e9397b1e794ccbda06f7f3b19f4ff9bc484",
      "description": "Preserve the V1-V3 status line when resizing"
    },
    {
      "file": "04-short-config.patch",
      "sha256": "2a78202adae218ef9f0a52073738a495f75705eb7f85863079cf162c47bbc242",
      "description": "Use Atari-compatible configuration file names"
    }
  ],
  "files": "files",
  "patched_tree_sha256": "5a51dcf60330494d9438deea348fe9d70c1a74d63599aca72dc26e3db04c7d83",
  "dependencies": [
    "ncurses"
  ],
  "host_tools": [
    "make"
  ],
  "build": {
    "prepare": [
      {
        "type": "run",
        "command": [
          "make",
          "-f",
          "Makefile.helios",
          "-j${jobs}",
          "CLANG=${clang}",
          "CPU=${cpu}",
          "SYSROOT=${sdk}",
          "HASMDIR=${asm_dir}",
          "NCURSES=${dep:ncurses}/stage/local",
          "COMPAT=${compat}"
        ],
        "cwd": "${src}"
      }
    ],
    "install": [
      {
        "type": "copy",
        "source": "${src}/build-helios/frotz",
        "destination": "${stage}/local/bin/frotz"
      },
      {
        "type": "copy",
        "source": "${src}/build-helios/dfrotz",
        "destination": "${stage}/local/bin/dfrotz"
      },
      {
        "type": "copy",
        "source": "${src}/COPYING",
        "destination": "${stage}/local/games/frotz/COPYING"
      },
      {
        "type": "copy",
        "source": "${src}/AUTHORS",
        "destination": "${stage}/local/games/frotz/AUTHORS"
      },
      {
        "type": "copy",
        "source": "${src}/README",
        "destination": "${stage}/local/games/frotz/README"
      }
    ],
    "outputs": [
      "${src}/doc/frotz.6"
    ]
  },
  "requires_compat": true
}
