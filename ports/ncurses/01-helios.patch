diff --git a/ncurses/base/lib_newterm.c b/ncurses/base/lib_newterm.c
index 91f67c2ff98e77efa4300068a669bae1543fc5c2..7d3af1f301303979f95e4e7dd0d0a028c0198b6b 100644
--- a/ncurses/base/lib_newterm.c
+++ b/ncurses/base/lib_newterm.c
@@ -86,6 +86,11 @@ _nc_initscr(NCURSES_SP_DCL0)
 	buf.c_lflag &= (unsigned) ~(ECHO | ECHONL);
 	buf.c_iflag &= (unsigned) ~(ICRNL | INLCR | IGNCR);
 	buf.c_oflag &= (unsigned) ~(ONLCR);
+#ifdef __HELIOS
+        /* Cooked Helios output interprets escapes itself. Let ncurses send
+         * its terminal-specific control sequences through unchanged. */
+        buf.c_oflag &= ~OPOST;
+#endif
 #elif HAVE_SGTTY_H
 	buf.sg_flags &= ~(ECHO | CRMOD);
 #elif USE_NAMED_PIPES
