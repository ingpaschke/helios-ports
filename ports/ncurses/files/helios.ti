# Capabilities used by the native X11R4 xterm. Shared by ncurses and S-Lang.
xterm|xterm-color|Helios X terminal,
    am, xenl, km,
    cols#80, lines#24, colors#8, pairs#64,
    bel=^G, cr=^M, cud1=^J, cub1=^H, cuf1=\E[C, cuu1=\E[A,
    clear=\E[H\E[2J, el=\E[K, ed=\E[J, home=\E[H,
    cup=\E[%i%p1%d;%p2%dH, csr=\E[%i%p1%d;%p2%dr,
    ind=^J, ri=\EM, il1=\E[L, dl1=\E[M, ich1=\E[@, dch1=\E[P,
    smso=\E[7m, rmso=\E[0m, smul=\E[4m, rmul=\E[0m,
    bold=\E[1m, rev=\E[7m, sgr0=\E[0m,
    setaf=\E[3%p1%dm, setab=\E[4%p1%dm, op=\E[39;49m,
    civis=\E[?25l, cnorm=\E[?25h,
    smcup=\E[?47h, rmcup=\E[?47l, smkx=\E[?1h\E=, rmkx=\E[?1l\E>,
    kcuu1=\EOA, kcud1=\EOB, kcuf1=\EOC, kcub1=\EOD,
    khome=\E[H, kend=\E[F, kich1=\E[2~, kdch1=\E[3~,
    kpp=\E[5~, knp=\E[6~, kbs=^?, kent=\EOM,
    kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS,
vt100|Helios VT100 terminal,
    colors@, pairs@, setaf@, setab@, op@, smcup@, rmcup@, use=xterm,
ansi|Helios ANSI terminal,
    kcuu1=\E[A, kcud1=\E[B, kcuf1=\E[C, kcub1=\E[D,
    smcup@, rmcup@, smkx@, rmkx@, use=vt100,
