# NetHack 5 defaults for Helios, shared by the tty and X11 interfaces.
# $HOME/nethack.cnf replaces this file if present. Copy it there to customise.

# Keep the familiar movement keys and manual pickup policy.
OPTIONS=number_pad:0,!autopickup,pickup_types:$?!/="+
OPTIONS=!tutorial

# Use complete item-selection menus; group and sort inventory entries.
OPTIONS=menustyle:full,menu_headings:bold,sortpack,sortloot:full
# Include the full extended-command list when pressing # in X11.
OPTIONS=extmenu
# X11 uses a single dialog to choose name, role, race, gender and alignment.
OPTIONS=player_selection:dialog

# Keep useful game information and a longer recallable message history.
OPTIONS=color,time,showexp,showscore,msghistory:100
OPTIONS=hilite_pet,hilite_pile
OPTIONS=hitpointbar,statushilites:3
OPTIONS=hilite_status:hitpoints/100%/green/<100%/green
OPTIONS=hilite_status:hitpoints/<50%/orange/<25%/red&inverse
OPTIONS=hilite_status:power/<25%/orange
OPTIONS=hilite_status:condition/major_troubles/red&inverse

# The X11 interface uses tiles; tty falls back to its character map.
OPTIONS=tiled_map

# Optional: a separate persistent inventory window (toggle with O in X11).
# OPTIONS=perm_invent
