+override TARGET = helios
+ifdef HELIOS_SMALL
+# whole-program build (bitcode objects): see cross-pre2.501
+override TARGETDIR=../targets/helios-small
+else
+override TARGETDIR=../targets/$(TARGET)
+endif
+override TARGETPFX = $(TARGETDIR)/
+override TARGET_LIBS=
+endif
+
 ifdef CROSS
 CROSSCOMPILE=1
 override PREGAME=
diff --git a/sys/unix/hints/include/cross-pre2.501 b/sys/unix/hints/include/cross-pre2.501
index d3265963464c900216deaa57e0d4aaf31daeba14..c833524fcfb12d98d5a39faa6a4ec553fc43dc9b 100644
--- a/sys/unix/hints/include/cross-pre2.501
+++ b/sys/unix/hints/include/cross-pre2.501
@@ -1188,6 +1188,134 @@ $(TARGETPFX)pcunix.o : ../sys/share/pcunix.c
 # the pcmain.o rule (-Dmain=nh_main) is in cross-post.501 so it wins
 # over the base recipe in Makefile.src
 endif  # CROSS_TO_ATW800
+
+ifdef CROSS_TO_HELIOS
+#=================================================================
+# Helios (transputer OS) cross-compile recipe
+#=================================================================
+# NetHack as a Helios program (the tty window port on termcap), built
+# with clang's Helios mode (--target=t800-unknown-helios) and linked by
+# the Helios assembler/linker `asm` against a Helios tree's c0.o, c.lib,
+# helios.lib and termcap.lib.
+#
+#   sys/unix/setup.sh sys/unix/hints/linux.501
+#   make CROSS_TO_HELIOS=1 fetch-regex
+#   make CROSS_TO_HELIOS=1 all
+#   make CROSS_TO_HELIOS=1 heliospkg
+#
+# HELIOS_SMALL=1 (with CROSS_TO_HELIOS=1, on every make command) builds
+# the small whole-program variant in targets/helios-small instead: each
+# source file to LLVM bitcode at -Oz, llvm-link of all of them (NetHack,
+# hacklib, Lua) into one module, internalize + globaldce (only main
+# stays external) and constmerge with opt, then one -Oz code generation
+# of that module without stack checks and procedure names, and the
+# Helios link.  About 0.5 MB less image than the default build; it fits
+# a 4 MB T805.  Recipe in cross-post.501 (Syshelios).
+#
+# Override on the make command line:
+#   LLVMBIN      the llvm-t800 build or install's bin (clang)
+#   HELIOS_ROOT  a Helios tree (include/, lib/c0.o, c.lib, helios.lib,
+#                termcap.lib)
+#   HELIOS_ASM   the Helios assembler/linker (64-bit helios-asm)
+#   HELIOS_RTLIB compiler-rt builtins as a Helios scanned library (i64
+#                division and the like that the backend calls)
+#   LLVM_LINK, OPT  llvm-link and opt (HELIOS_SMALL only)
+#=================================================================
+LLVMBIN ?= /opt/llvm-t800/bin
+HELIOS_ROOT ?= /opt/llvm-t800/sysroots/helios
+HELIOS_ASM ?= asm
+HELIOS_RTLIB ?= $(LLVMBIN)/../sysroots/helios/lib/llvmrt-generic.lib
+# where the game lives on the Helios machine (/helios is the Helios
+# tree's root): data, sysconf, save files, record
+HELIOS_HACKDIR ?= /helios/local/games/nethack
+LLVM_LINK ?= $(LLVMBIN)/llvm-link
+OPT ?= $(LLVMBIN)/opt
+# -Os: see the atw800 recipe; HELIOS_OPT=-Oz for the smallest image
+# (the HELIOS_SMALL variant uses -Oz)
+ifdef HELIOS_SMALL
+HELIOS_OPT ?= -Oz
+else
+HELIOS_OPT ?= -Os
+endif
+
+CFLAGS += -DCROSSCOMPILE
+
+# generic transputer code (the T425 and the T805 run it); floating point
+# goes through Helios's FpLib, which uses the FPU where there is one
+override TARGET_CC = $(LLVMBIN)/clang --target=t800-unknown-helios \
+	--sysroot=$(HELIOS_ROOT) -B$(dir $(HELIOS_ASM))
+override TARGET_CXX = $(TARGET_CC)
+# Helios has no ar: a scanned library is its objects concatenated
+override TARGET_AR = sh ../sys/helios/hlibar.sh
+override TARGET_ARFLAGS = rcs
+override TARGET_STUBEDIT=
+override TARGET_CFLAGS = $(HELIOS_OPT) -std=gnu99 -w \
+	-Wno-error=implicit-function-declaration -Wno-error=implicit-int \
+	-Wno-error=incompatible-pointer-types -Wno-error=int-conversion \
+	-I../include -I../win/share -I../sys/helios -I../sys/helios/include \
+	-I../sys/amiga/regex $(LUAINCL) -DLUA_32BITS \
+	-DCROSSCOMPILE -DCROSSCOMPILE_TARGET -DCROSS_TO_HELIOS -DHELIOS \
+	-DTTY_GRAPHICS -DDEFAULT_WINDOW_SYS=\"tty\" -DDLB -DNO_TERMCAP_HEADERS \
+	-DHACKDIR=\"$(HELIOS_HACKDIR)\" -DSYSCF -DSYSCF_FILE=\"sysconf\" \
+	-DNOPANICTRACE -DNOCRASHREPORT \
+	-DNOSTATICFN
+ifdef HELIOS_SMALL
+# the same compile lines, but every "object" is LLVM bitcode for the
+# whole-program link in cross-post.501
+override TARGET_CFLAGS += -emit-llvm
+# code generation of the one module: no stack checks (no overflow
+# detection) and no procedure names (none in Helios debuggers)
+HELIOS_SMALL_CGFLAGS ?= -mllvm -t800-helios-stack-check=0 \
+	-mllvm -t800-helios-proc-names=0
+endif
+override TARGET_CXXFLAGS = $(TARGET_CFLAGS)
+LUA_TARGET_CFLAGS = $(TARGET_CFLAGS) -DLUA_USE_JUMPTABLE=0
+override TARGET_LINK = $(TARGET_CC)
+
+# POSIX regex over the BSD engine in sys/amiga/regex (make fetch-regex)
+override REGEXOBJ = $(TARGETPFX)posixregex.o $(TARGETPFX)regcomp.o \
+	$(TARGETPFX)regexec.o $(TARGETPFX)regerror.o $(TARGETPFX)regfree.o
+override RANDOBJ =
+override HINTOBJ =
+override SNDLIBOBJ =
+override UUIDOBJ =
+
+# no git version stamps in the target image
+override GITHASH =
+override GITBRANCH =
+override GITPREFIX =
+
+# the Unix main, tty and file code, plus what Helios's C library lacks
+override SYSSRC = ../sys/share/ioctl.c ../sys/share/unixtty.c \
+	../sys/unix/unixmain.c ../sys/unix/unixunix.c ../sys/helios/helios.c
+override SYSOBJ = $(TARGETPFX)ioctl.o $(TARGETPFX)unixtty.o \
+	$(TARGETPFX)unixmain.o $(TARGETPFX)unixunix.o $(TARGETPFX)helios.o
+override WINSRC = $(WINTTYSRC)
+override WINOBJ = $(WINTTYOBJ)
+override WINLIB =
+override LUALIB =
+override LUALIBS =
+override TOPLUALIB =
+override DLLIB =
+override GAMEBIN = $(TARGETPFX)nethack
+# link recipe in cross-post.501
+override SYSTEM = $(TARGETPFX)Syshelios
+override TARGET_LFLAGS =
+override PACKAGE = heliospkg
+override PREGAME += mkdir -p $(TARGETDIR) ;
+override CLEANMORE += rm -r $(TARGETDIR) ;
+
+$(TARGETPFX)%.o : ../sys/helios/%.c
+	$(TARGET_CC) $(TARGET_CFLAGS) -c -o$@ $<
+$(TARGETPFX)%.o : ../sys/amiga/regex/%.c
+	$(TARGET_CC) $(TARGET_CFLAGS) -c -o$@ $<
+$(TARGETPFX)%.o : ../sys/unix/%.c
+	$(TARGET_CC) $(TARGET_CFLAGS) -c -o$@ $<
+$(TARGETPFX)%.o : ../sys/share/%.c
+	$(TARGET_CC) $(TARGET_CFLAGS) -c -o$@ $<
+$(TARGETPFX)%.o : ../win/tty/%.c
+	$(TARGET_CC) $(TARGET_CFLAGS) -c -o$@ $<
+endif  # CROSS_TO_HELIOS
 #=================================================================
 
 ifdef WANT_WIN_CURSES
