diff --git a/sys/unix/hints/include/cross-post.501 b/sys/unix/hints/include/cross-post.501
index d3c14b646c4eb0c02c5611a9bda8c285808eceeb..6f2e4f318d7b1c33af1e8ec2c08f53cfd917c0e5 100644
--- a/sys/unix/hints/include/cross-post.501
+++ b/sys/unix/hints/include/cross-post.501
@@ -899,6 +899,92 @@ atw800pkg: $(ATWTILES) $(ATWGEN) ../util/uudecode
 	@echo "atw800 release -> ../build-atw/NETHACK/ and ../build-atw/nethack-atw.zip"
 endif  # CROSS_TO_ATW800
 
+ifdef CROSS_TO_HELIOS
+# tile.c is not used by tty; date.o and the objects as for the others
+$(TARGETPFX)tile.o : $(SRCDIR)/tile.c
+	$(TARGET_CC) $(TARGET_CFLAGS) -c -o$@ $<
+
+# Link through clang's Helios driver: asm -o nethack -nnethack c0.o
+# <objects> <libraries> c.lib helios.lib.  The -s (stack) and -h (heap
+# growth granule) sizes are in bytes and land in the program's image
+# header; Helios's C library does not grow the stack, so -s must cover
+# the deepest call chain (Lua's parser and the level generator).
+# The heap grows in 8 KB steps: with 64 KB the last heap extension of
+# the small build found no contiguous free block on a 4 MB T805 ("cannot
+# extend to 68 bytes" on level 1); on a 5 MB T425 the default build
+# keeps as much free with 8 KB steps as with 64 KB (0.64-0.67 MB vs
+# 0.65 MB least free in the same wizard-mode script; levels are random).
+HELIOS_STACK ?= 131072
+HELIOS_HEAP ?= 8192
+# the link stamp lives in the target directory, so the two variants
+# (targets/helios, targets/helios-small) each relink when needed
+ifndef HELIOS_SMALL
+HELIOS_LIBS = -l$(TARGET_HACKLIB) -l$(LUACROSSLIB) \
+	-l$(HELIOS_ROOT)/lib/termcap.lib -l$(HELIOS_RTLIB)
+$(TARGETPFX)Syshelios: $(HOBJ) $(TARGETPFX)date.o $(TARGET_HACKLIB) \
+		$(LUACROSSLIB) $(BUILDMORE) Makefile
+	@echo "Linking $(GAME) for Helios."
+	$(TARGET_CC) \
+		-Wl,-s$(HELIOS_STACK) -Wl,-h$(HELIOS_HEAP) -o $(GAMEBIN) \
+		$(HOBJ) $(TARGETPFX)date.o $(HELIOS_LIBS)
+	@touch $@
+	@ls -l $(GAMEBIN)
+else
+# Whole-program link (HELIOS_SMALL): every .o in targets/helios-small is
+# LLVM bitcode.  The modules are linked in name order (the order the
+# variant was measured and tested with); hacklib.o and the Lua objects
+# are used directly, not through hacklib.a / lua.a.  internalize +
+# globaldce drop everything main does not reach, constmerge shares equal
+# constants (string literals) across files, then clang optimises and
+# generates code for the one module.
+HELIOS_BC = $(sort $(HOBJ) $(TARGETPFX)date.o $(TARGETPFX)hacklib.o \
+	$(LUALIBOBJS))
+HELIOS_LIBS = -l$(HELIOS_ROOT)/lib/termcap.lib -l$(HELIOS_RTLIB)
+$(TARGETPFX)Syshelios: $(HELIOS_BC) $(BUILDMORE) Makefile
+	@echo "Linking $(GAME) for Helios (whole program)."
+	$(LLVM_LINK) -o $(TARGETPFX)whole.bc $(HELIOS_BC)
+	$(OPT) -passes=internalize,globaldce \
+		-internalize-public-api-list=main \
+		-o $(TARGETPFX)whole-int.bc $(TARGETPFX)whole.bc
+	$(OPT) -passes=constmerge -o $(TARGETPFX)whole-cm.bc \
+		$(TARGETPFX)whole-int.bc
+	$(TARGET_CC) $(HELIOS_OPT) $(HELIOS_SMALL_CGFLAGS) -S \
+		-o $(TARGETPFX)whole.s $(TARGETPFX)whole-cm.bc
+	$(TARGET_CC) \
+		-Wl,-s$(HELIOS_STACK) -Wl,-h$(HELIOS_HEAP) -o $(GAMEBIN) \
+		$(TARGETPFX)whole.s $(HELIOS_LIBS)
+	@touch $@
+	@ls -l $(GAMEBIN)
+endif
+
+# a change in the port header recompiles every target object
+$(HOBJ): ../include/heliosconf.h
+
+# Copy-ready tree for a Helios root (8.3 names, upper case for a GEMDOS
+# host file system): LOCAL/GAMES/NETHACK holds the program and its data.
+# One package for both variants: NETHACK is the default build
+# (targets/helios), NETHACKS the HELIOS_SMALL build (targets/helios-small);
+# each is included when it has been built.
+HELREL = ../targets/helios/pkg
+HELGAME = $(HELREL)/LOCAL/GAMES/NETHACK
+.PHONY: heliospkg
+heliospkg: $(GAMEBIN)
+	rm -rf $(HELREL) ; mkdir -p $(HELGAME)/SAVE
+	if [ -f ../targets/helios/nethack ]; then \
+		cp ../targets/helios/nethack $(HELGAME)/NETHACK ; fi
+	if [ -f ../targets/helios-small/nethack ]; then \
+		cp ../targets/helios-small/nethack $(HELGAME)/NETHACKS ; fi
+	cp ../dat/nhdat $(HELGAME)/NHDAT
+	cp ../dat/license $(HELGAME)/LICENSE
+	cp ../dat/symbols $(HELGAME)/SYMBOLS
+	cp ../sys/helios/sysconf $(HELGAME)/SYSCONF
+	cp ../sys/helios/nethack.cnf $(HELGAME)/NETHACK.CNF
+	: > $(HELGAME)/PERM ; : > $(HELGAME)/RECORD ; : > $(HELGAME)/LOGFILE
+	: > $(HELGAME)/XLOGFILE
+	cp ../sys/helios/README.txt $(HELREL)/README.TXT
+	@echo "helios package -> $(HELREL)"
+endif  # CROSS_TO_HELIOS
+
 ifdef CROSS_SHARED
 # shared file dependencies
 $(TARGETPFX)pcmain.o : ../sys/share/pcmain.c $(HACK_H)
diff --git a/sys/unix/hints/include/cross-pre1.501 b/sys/unix/hints/include/cross-pre1.501
index 852a1c685c03c8298a9da73b2dc417880d1d5def..b91b83260d810a6895ba5c8b2fb031ef960d8418 100644
--- a/sys/unix/hints/include/cross-pre1.501
+++ b/sys/unix/hints/include/cross-pre1.501
@@ -89,6 +89,21 @@ override TARGETPFX = $(TARGETDIR)/
 override TARGET_LIBS=
 endif
 
+ifdef CROSS_TO_HELIOS
+CROSS=1
+BUILD_TARGET_LUA=1
