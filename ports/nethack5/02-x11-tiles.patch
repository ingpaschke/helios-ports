Subject: Add the X11 interface (X11R4, core-font text path) with the binary x11tiles tile set; tty and X11 in one binary, -w selects

diff --git a/sys/unix/hints/include/cross-post.501 b/sys/unix/hints/include/cross-post.501
index 6f2e4f318d7b1c33af1e8ec2c08f53cfd917c0e5..7162281f074243aaac72c7605c717fbd292ffd59 100644
--- a/sys/unix/hints/include/cross-post.501
+++ b/sys/unix/hints/include/cross-post.501
@@ -916,11 +916,20 @@ $(TARGETPFX)tile.o : $(SRCDIR)/tile.c
 # 0.65 MB least free in the same wizard-mode script; levels are random).
 HELIOS_STACK ?= 131072
 HELIOS_HEAP ?= 8192
+# X11R4 scanned libraries from the Helios tree (widget set before
+# toolkit before core; Xau for the authentication lookups in libX11;
+# xlib.def indexes the core Xlib modules, bsd.lib supplies the BSD
+# primitives the X libraries call; same set as the 3.1.3 X11 link)
+HELIOS_X11LIBS = -l$(HELIOS_X11_ROOT)/lib/libXaw.a \
+	-l$(HELIOS_X11_ROOT)/lib/libXmu.a -l$(HELIOS_X11_ROOT)/lib/libXt.a \
+	-l$(HELIOS_X11_ROOT)/lib/libXext.a -l$(HELIOS_X11_ROOT)/lib/libX11.a \
+	-l$(HELIOS_X11_ROOT)/lib/libXau.a -l$(HELIOS_ROOT)/lib/bsd.lib \
+	-l$(HELIOS_ROOT)/lib/fplib.def
 # the link stamp lives in the target directory, so the two variants
 # (targets/helios, targets/helios-small) each relink when needed
 ifndef HELIOS_SMALL
 HELIOS_LIBS = -l$(TARGET_HACKLIB) -l$(LUACROSSLIB) \
-	-l$(HELIOS_ROOT)/lib/termcap.lib -l$(HELIOS_RTLIB)
+	-l$(HELIOS_ROOT)/lib/termcap.lib $(HELIOS_X11LIBS) -l$(HELIOS_RTLIB)
 $(TARGETPFX)Syshelios: $(HOBJ) $(TARGETPFX)date.o $(TARGET_HACKLIB) \
 		$(LUACROSSLIB) $(BUILDMORE) Makefile
 	@echo "Linking $(GAME) for Helios."
@@ -939,7 +948,8 @@ else
 # generates code for the one module.
 HELIOS_BC = $(sort $(HOBJ) $(TARGETPFX)date.o $(TARGETPFX)hacklib.o \
 	$(LUALIBOBJS))
-HELIOS_LIBS = -l$(HELIOS_ROOT)/lib/termcap.lib -l$(HELIOS_RTLIB)
+HELIOS_LIBS = -l$(HELIOS_ROOT)/lib/termcap.lib $(HELIOS_X11LIBS) \
+	-l$(HELIOS_RTLIB)
 $(TARGETPFX)Syshelios: $(HELIOS_BC) $(BUILDMORE) Makefile
 	@echo "Linking $(GAME) for Helios (whole program)."
 	$(LLVM_LINK) -o $(TARGETPFX)whole.bc $(HELIOS_BC)
diff --git a/sys/unix/hints/include/cross-pre2.501 b/sys/unix/hints/include/cross-pre2.501
index c833524fcfb12d98d5a39faa6a4ec553fc43dc9b..6c1ac443abc0a50f489604a4c44eec383fb60ead 100644
--- a/sys/unix/hints/include/cross-pre2.501
+++ b/sys/unix/hints/include/cross-pre2.501
@@ -1227,7 +1227,8 @@ HELIOS_ASM ?= asm
 HELIOS_RTLIB ?= $(LLVMBIN)/../sysroots/helios/lib/llvmrt-generic.lib
 # where the game lives on the Helios machine (/helios is the Helios
 # tree's root): data, sysconf, save files, record
-HELIOS_HACKDIR ?= /helios/local/games/nethack
+HELIOS_HACKDIR ?= /helios/local/games/nh50
+HELIOS_X11_ROOT ?= $(HELIOS_ROOT)
 LLVM_LINK ?= $(LLVMBIN)/llvm-link
 OPT ?= $(LLVMBIN)/opt
 # -Os: see the atw800 recipe; HELIOS_OPT=-Oz for the smallest image
@@ -1255,7 +1256,8 @@ override TARGET_CFLAGS = $(HELIOS_OPT) -std=gnu99 -w \
 	-I../include -I../win/share -I../sys/helios -I../sys/helios/include \
 	-I../sys/amiga/regex $(LUAINCL) -DLUA_32BITS \
 	-DCROSSCOMPILE -DCROSSCOMPILE_TARGET -DCROSS_TO_HELIOS -DHELIOS \
-	-DTTY_GRAPHICS -DDEFAULT_WINDOW_SYS=\"tty\" -DDLB -DNO_TERMCAP_HEADERS \
+	-DTTY_GRAPHICS -DX11_GRAPHICS -Dhelios -DDEFAULT_WINDOW_SYS=\"tty\" \
+	-DDLB -DNO_TERMCAP_HEADERS \
 	-DHACKDIR=\"$(HELIOS_HACKDIR)\" -DSYSCF -DSYSCF_FILE=\"sysconf\" \
 	-DNOPANICTRACE -DNOCRASHREPORT \
 	-DNOSTATICFN
@@ -1286,12 +1288,29 @@ override GITBRANCH =
 override GITPREFIX =
 
 # the Unix main, tty and file code, plus what Helios's C library lacks
+# heliosx.c supplies the effective-uid compatibility call.
 override SYSSRC = ../sys/share/ioctl.c ../sys/share/unixtty.c \
-	../sys/unix/unixmain.c ../sys/unix/unixunix.c ../sys/helios/helios.c
+	../sys/unix/unixmain.c ../sys/unix/unixunix.c \
+	../sys/helios/helios.c ../sys/helios/heliosx.c
 override SYSOBJ = $(TARGETPFX)ioctl.o $(TARGETPFX)unixtty.o \
-	$(TARGETPFX)unixmain.o $(TARGETPFX)unixunix.o $(TARGETPFX)helios.o
-override WINSRC = $(WINTTYSRC)
-override WINOBJ = $(WINTTYOBJ)
+	$(TARGETPFX)unixmain.o $(TARGETPFX)unixunix.o \
+	$(TARGETPFX)helios.o $(TARGETPFX)heliosx.o
+# X11 headers from the toolchain sysroot (proper case; the Helios tree
+# copies carry 8.3 names) and _BSD for Helios's sys/file.h (Xos.h).
+# X11_BUILD keeps tradstdc.h's unavailable index()/rindex() declarations
+# out (Xos.h maps index to strchr).  Kept out of TARGET_CFLAGS: the rest
+# of the game builds as before.
+override X11CFLAGS = -I$(HELIOS_X11_ROOT)/include -D_BSD -DX11_BUILD \
+	-DNeedFunctionPrototypes=0 -DNeedWidePrototypes=0
+# tty and X11 in one binary: the window system is chosen at run time
+# (-w x11 or OPTIONS=window:x11); the default stays tty.  X11 uses the
+# X11R4 libraries in the Helios tree; Xft/Xpm/PNG are not built, so the
+# core-font text path and the binary x11tiles format carry the tiles.
+# tile.c (generated by the tilemap host tool) carries glyphmap[] and
+# friends with TILES_IN_GLYPHMAP, which X11_GRAPHICS turns on: tile.o
+# goes into WINOBJ, as include/config.h directs for that configuration
+override WINSRC = $(WINTTYSRC) $(WINX11SRC) $(SRCDIR)/tile.c
+override WINOBJ = $(WINTTYOBJ) $(WINX11OBJ) $(TARGETPFX)tile.o
 override WINLIB =
 override LUALIB =
 override LUALIBS =
@@ -1315,6 +1334,11 @@ $(TARGETPFX)%.o : ../sys/share/%.c
 	$(TARGET_CC) $(TARGET_CFLAGS) -c -o$@ $<
 $(TARGETPFX)%.o : ../win/tty/%.c
 	$(TARGET_CC) $(TARGET_CFLAGS) -c -o$@ $<
+$(TARGETPFX)%.o : ../win/X11/%.c
+	$(TARGET_CC) $(TARGET_CFLAGS) $(X11CFLAGS) -c -o$@ $<
+# the effective-uid adapter uses the same platform declarations
+$(TARGETPFX)heliosx.o : ../sys/helios/heliosx.c
+	$(TARGET_CC) $(TARGET_CFLAGS) $(X11CFLAGS) -c -o$@ $<
 endif  # CROSS_TO_HELIOS
 #=================================================================
 
