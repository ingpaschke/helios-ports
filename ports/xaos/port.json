  },
  "patches": [
    {
      "file": "01-native-runtime.patch",
      "description": "Connect Helios task startup and configuration paths",
      "sha256": "9c82d5c4b60bcca6bddc2df3d9577d46176666959b1d23a553b7a5af5547c0fb"
    },
    {
      "file": "02-distributed-render.patch",
      "description": "Keep the incremental zoom cache and distribute missing pixels over native channels",
      "sha256": "4d050014a95ac8dc779885a8074872f3c557d895a56ff49a6d6f316afecb6ffb"
    },
    {
      "file": "03-preview-policy.patch",
      "sha256": "52b47be37f1ab64042d2ce0dbf1a34b661f2ab7bd7330ab6f5e711981e501f70",
      "description": "Keep adaptive previews while moving and finish stationary images without preview deadlines"
    },
    {
      "file": "04-resize-memory.patch",
      "sha256": "6853a87bc2fcd25fdcf609d74352435dae417c3d1c7c1c3e3a732d2f91ff03cb",
      "description": "Recover from X11 image-buffer allocation failures and defer resizes during rendering"
    }
  ],
  "files": "files",
  "dependencies": [
