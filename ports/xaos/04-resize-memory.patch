     return 0;
 }
 
-static void ui_mkimages(int w, int h)
+static int ui_try_mkimages(int w, int h)
 {
     struct palette *palette;
     int scanline;
     int width, height;
     union paletteinfo info;
     char *b1, *b2;
-    void *data;
+    void *data = NULL;
     width = w;
     height = h;
     if (resizeregistered && !(driver->flags & RESIZE_COMMAND)) {
@@ -1584,11 +1585,9 @@ static void ui_mkimages(int w, int h)
             resizeregistered = 1;
         }
     }
-    if (!(scanline = driver->alloc_buffers(&b1, &b2, &data))) {
