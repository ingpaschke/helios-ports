Subject: Recover from X11 image-buffer allocation failures and defer resizes during rendering

diff --git a/src/ui/ui-drv/x11/ui_x11.c b/src/ui/ui-drv/x11/ui_x11.c
index bc1f8f575e2326233a8f6d8402efe60fbce21d2e..a918ea9c3809ba9df1f779217134ac21b6750e9a 100644
--- a/src/ui/ui-drv/x11/ui_x11.c
+++ b/src/ui/ui-drv/x11/ui_x11.c
@@ -40,6 +40,7 @@
 xlibparam xparams = { 0, 0, 0, 0, NULL, -1 };
 
 static int allocated;
+static int retry_previous_size;
 Cursor normal, xwait, replay;
 
 struct ui_driver x11_driver;
@@ -144,10 +145,22 @@ static int x11_alloc_buffers(char **b1, char **b2, void **data)
 {
     if (!allocated) {
 	XSync(d->display, 0);
-	allocated = 1;
-	if (!alloc_image(d)) {
-	    return (0);
-	}
+        if (!alloc_image(d)) {
+            /* The old pixels have been released, but their dimensions
+             * remain available for restoring a resize that does not fit. */
+            if (d->bwidth != 0 && d->bheight != 0) {
+                fprintf(stderr, "XaoS: cannot allocate %ux%u image buffers; "
+                        "restoring %ux%u\n", d->width, d->height,
+                        d->bwidth, d->bheight);
+                d->width = d->bwidth;
+                d->height = d->bheight;
+                retry_previous_size = 1;
+                XResizeWindow(d->display, d->window, d->width, d->height);
+                XSync(d->display, 0);
+            }
+            return 0;
+        }
+        allocated = 1;
 	xflip_buffers(d);
     }
     *b1 = d->vbuff;
@@ -164,7 +177,13 @@ static int x11_alloc_buffers(char **b1, char **b2, void **data)
 static void x11_getsize(int *w, int *h)
 {
     XSync(d->display, 0);
-    xupdate_size(d);
+    if (retry_previous_size) {
+        /* The window manager may not have applied the rollback yet.
+         * Report the saved dimensions for the image-allocation retry. */
+        retry_previous_size = 0;
+    } else {
+        xupdate_size(d);
+    }
     *w = d->width;
     *h = d->height;
 }
diff --git a/src/ui/ui-drv/x11/xlib.c b/src/ui/ui-drv/x11/xlib.c
index 87308b8c14d21191b887f1f441fdfc5e40b4c7b0..768cd7944ecb738ae6ca2f73df77435d0f3119c1 100644
--- a/src/ui/ui-drv/x11/xlib.c
+++ b/src/ui/ui-drv/x11/xlib.c
@@ -179,10 +179,10 @@ void free_shm_image(xdisplay * d)
 int alloc_image(xdisplay * d)
 {
     int i;
-    d->bwidth = d->width;
-    d->bheight = d->height;
 #ifdef MITSHM
     if (!d->params->nomitshm && d->depth != 1 && alloc_shm_image(d)) {
+        d->bwidth = d->width;
+        d->bheight = d->height;
 	return 1;
     }
 #endif
@@ -192,16 +192,18 @@ int alloc_image(xdisplay * d)
 	    XCreateImage(d->display, d->visual, d->depth,
 			 d->depth == 1 ? XYBitmap : ZPixmap, 0, NULL,
 			 d->width, d->height, 32, 0);
-	if (d->image[i] == NULL) {
-	    printf("Out of memory for image..exiting\n");
-	    exit(-1);
-	}
-	d->image[i]->data =
-	    malloc(d->image[i]->bytes_per_line * d->height);
-	if (d->image[i]->data == NULL) {
-	    printf("Out of memory for image buffers..exiting\n");
-	    exit(-1);
-	}
+        if (d->image[i] == NULL) {
+            goto failed;
+        }
+        if (d->image[i]->bytes_per_line <= 0 || d->height == 0 ||
+            d->height > (size_t) -1 / d->image[i]->bytes_per_line) {
+            goto failed;
+        }
+        d->image[i]->data =
+            malloc((size_t) d->image[i]->bytes_per_line * d->height);
+        if (d->image[i]->data == NULL) {
+            goto failed;
+        }
 	{
 	    unsigned char c[4];
 	    int byteexact = 0;
@@ -237,20 +239,35 @@ int alloc_image(xdisplay * d)
 	d->data[i] = d->vbuffs[i] = (char *) d->image[i]->data;
 	d->linewidth = d->image[i]->bytes_per_line;
     }
+    d->bwidth = d->width;
+    d->bheight = d->height;
     xflip_buffers(d);
     return 1;
+
+failed:
+    free_image(d);
+    return 0;
 }
 
 void free_image(xdisplay * d)
 {
+    int i;
 #ifdef MITSHM
     if (d->SharedMemFlag) {
 	free_shm_image(d);
 	return;
     }
 #endif
-    XDestroyImage(d->image[0]);
-    XDestroyImage(d->image[1]);
+    for (i = 0; i < 2; i++) {
+        if (d->image[i] != NULL) {
+            XDestroyImage(d->image[i]);
+            d->image[i] = NULL;
+        }
+        d->data[i] = NULL;
+        d->vbuffs[i] = NULL;
+    }
+    d->vbuff = NULL;
+    d->back = NULL;
 }
 
 #define MAX(x,y) ((x)>(y)?(x):(y))
diff --git a/src/ui/ui.c b/src/ui/ui.c
