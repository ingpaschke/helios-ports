-        x_error(gettext("Can not allocate buffers"));
-        ui_outofmem();
-        exit_xaos(-1);
+    scanline = driver->alloc_buffers(&b1, &b2, &data);
+    if (!scanline) {
+        return 0;
     }
     info.truec.rmask = driver->rmask;
     info.truec.gmask = driver->gmask;
@@ -1622,18 +1621,30 @@ static void ui_mkimages(int w, int h)
     }
     image->data = data;
     image->driver = driver->image_driver;
+    return 1;
+}
+
+static void ui_mkimages(int w, int h)
+{
+    if (!ui_try_mkimages(w, h)) {
+        driver->uninit();
+        x_error(gettext("Can not allocate buffers"));
+        ui_outofmem();
+        exit_xaos(-1);
+    }
 }
 
 void ui_resize(void)
 {
     int w, h;
+    int rejected = 0;
 
     /* Prevent crash on startup for Mac OS X */
     if (!uih)
         return;
 
     if (uih->incalculation) {
-        uih_interrupt(uih);
+        ui_call_resize();
         return;
     }
     ui_closemenus();
@@ -1651,7 +1662,13 @@ void ui_resize(void)
         driver->free_buffers(NULL, NULL);
         destroy_image(uih->image);
         destroypalette(uih->palette);
-        ui_mkimages(w, h);
+        if (!ui_try_mkimages(w, h)) {
+            /* A driver may restore the previous window size when the new
+             * buffers do not fit. Rebuild the image at that reported size. */
+            driver->getsize(&w, &h);
+            ui_mkimages(w, h);
+            rejected = 1;
+        }
         if (!uih_updateimage(uih, image)) {
             driver->uninit();
             x_error(gettext("Can not allocate tables"));
@@ -1665,6 +1682,9 @@ void ui_resize(void)
     }
     uih_newimage(uih);
     uih_restorepalette(uih);
+    if (rejected) {
+        uih_error(uih, gettext("Not enough memory for the requested window size"));
+    }
     /*uih_mkdefaultpalette(uih); */
     uih->display = 1;;
     uih_cycling_continue(uih);
