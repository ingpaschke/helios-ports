+/* Helios nodes do not share pointers or pixels. Keep the incremental move
+ * tables locally and distribute just the union of changed rows/columns. */
+static int helios_render_idle(void)
+{
+    if (hx_preview_ready()) cfilter.readyforinterrupt = 1;
+    callwait();
+    return cfilter.interrupt;
+}
+static int helios_calculate_changed(void)
+{
+    int x, y, result;
+    number_t *xp = malloc(cimage.width * sizeof(*xp));
+    number_t *yp = malloc(cimage.height * sizeof(*yp));
+    unsigned char *dx = malloc(cimage.width), *dy = malloc(cimage.height);
+    if (!xp || !yp || !dx || !dy) {
+        free(xp); free(yp); free(dx); free(dy); return 0;
+    }
+    for (x = 0; x < cimage.width; x++) {
+        xp[x] = czoomc.reallocx[x].possition;
+        dx[x] = czoomc.reallocx[x].dirty || czoomc.reallocx[x].recalculate;
+    }
+    for (y = 0; y < cimage.height; y++) {
+        yp[y] = czoomc.reallocy[y].possition;
+        dy[y] = czoomc.reallocy[y].dirty || czoomc.reallocy[y].recalculate;
+    }
+    cfilter.pass = "Rendering on Helios processors";
+    cfilter.incalculation = 1;
+    result = hx_render(xp, yp, dx, dy, helios_render_idle);
+    cfilter.incalculation = 0;
+    if (result) {
+        int remaining = 0;
+        for (x = 0; x < cimage.width; x++) {
+            czoomc.reallocx[x].dirty = czoomc.reallocx[x].recalculate = dx[x];
+            remaining += dx[x] != 0;
+        }
+        for (y = 0; y < cimage.height; y++) {
+            czoomc.reallocy[y].dirty = czoomc.reallocy[y].recalculate = dy[y];
+            remaining += dy[y] != 0;
+        }
+        nsymetrized = 0;
+        getzcontext(&cfilter)->uncomplette = remaining;
+        setchanged(1);
+        /* Keep XaoS's normal time-limited preview and nearest-line fill.
+         * Dirty reallocation entries are refined by subsequent frames. */
+        if (remaining) fill();
+    }
+    free(xp); free(yp); free(dx); free(dy);
+    return result;
+}
