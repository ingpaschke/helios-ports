 #include <nonansi.h>
 #endif
 
@@ -112,7 +113,24 @@ TerminalRead(buf, n)
 char	*buf;
 int	n;
 {
-    return read(tin, buf, n);
+#ifdef __HELIOS
+    /* ttyserv normalizes terminal keys to Helios CSI sequences. Network
+     * terminals expect their seven-bit forms, even when input is raw. */
+    unsigned char input[256];
+    int count, i, used=0;
+    if (n<2) return read(tin,buf,n);
+    count=read(tin,input,n/2>sizeof(input)?sizeof(input):n/2);
+    if (count<=0) return count;
+    for (i=0;i<count;++i) {
+        if (input[i]==0x9b || input[i]==0x8f) {
+            buf[used++]=0x1b;
+            buf[used++]=input[i]==0x9b?'[':'O';
+        } else buf[used++]=input[i];
+    }
+    return used;
+#else
+    return read(tin,buf,n);
+#endif
 }
 
