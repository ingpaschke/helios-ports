+static void
+KtmWindowSize(int force)
+{
+    static int cols=-1, rows=-1;
+    Attributes a;
+    extern int tin;
+    unsigned char packet[13];
+    int n;
+    if (!myopts[TELOPT_NAWS] || GetAttributes(fdstream(tin),&a)<0 ||
+        a.Time<1 || a.Min<1) return;
+    if (!force && cols==a.Time && rows==a.Min) return;
+    n=ktm_naws(packet,a.Time,a.Min);
+    if (ring_empty_count(&netoring)<n) return;
+    ring_supply_data(&netoring,packet,n);
+    cols=a.Time; rows=a.Min; flushline=1;
+}
