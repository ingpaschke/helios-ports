     { "altscreen",	do_altscreen, NULL },		/* 14 */
     { "line1",		NULL, NULL },			/* 15 */
     { "softreset",	do_softreset, NULL },		/* 16 */
-    { "hardreset",	do_hardreset, NULL },		/* 17 */
-    { "line2",		NULL, NULL },			/* 18 */
+    { "hardreset",	do_hardreset, NULL }
+#ifndef HELIOS_VT_ONLY
+    , { "line2",		NULL, NULL },			/* 18 */
