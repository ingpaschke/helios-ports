--- a/clients/xterm/menu.h
+++ b/clients/xterm/menu.h
@@ -262,3 +262,13 @@ extern void HandleAllowSends(), HandleVisualBell(),
   update_menu_item (term->screen.fontMenu, \
 		    fontMenuEntries[term->screen.menu_font_number].widget, \
 		    (val))
+
+/* A VT-only menu has no Tek-mode, Tek-window or hide-VT entries. */
+#ifdef HELIOS_VT_ONLY
+#undef update_tekshow
+#undef update_vttekmode
+#undef set_vthide_sensitivity
+#define update_tekshow() ((void)0)
+#define update_vttekmode() ((void)0)
+#define set_vthide_sensitivity() ((void)0)
+#endif
