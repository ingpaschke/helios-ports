+#endif
+};
 
 MenuEntry fontMenuEntries[] = {
     { "fontdefault",	do_vtfont, NULL },		/*  0 */
@@ -188,12 +191,16 @@ static Bool domenu (w, event, params, param_count)
 	break;
 
       case 't':
+#ifdef HELIOS_VT_ONLY
+        return False;
+#else
 	if (!screen->tekMenu) {
 	    screen->tekMenu = create_menu (term, toplevel, "tekMenu",
