 					   XtNumber(tekMenuEntries));
 	    set_tekfont_menu_item (screen->cur.fontsize, TRUE);
 	}
+#endif
 	break;
 
       default:
diff --git a/clients/xterm/menu.h b/clients/xterm/menu.h
