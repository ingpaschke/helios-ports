Subject: Build a VT-only native terminal with no default scrollback

diff --git a/clients/xterm/main.c b/clients/xterm/main.c
index 775829aded35fdc0e0122e4c77c2916cff9e1697..0186b398b1e46150e9ed685da06ae7e4177696b2 100644
--- a/clients/xterm/main.c
+++ b/clients/xterm/main.c
@@ -375,8 +375,10 @@ static XrmOptionDescRec optionDescList[] = {
 {"-sk",		"*scrollKey",	XrmoptionNoArg,		(caddr_t) "on"},
 {"+sk",		"*scrollKey",	XrmoptionNoArg,		(caddr_t) "off"},
 {"-sl",		"*saveLines",	XrmoptionSepArg,	(caddr_t) NULL},
+#ifndef HELIOS_VT_ONLY
 {"-t",		"*tekStartup",	XrmoptionNoArg,		(caddr_t) "on"},
 {"+t",		"*tekStartup",	XrmoptionNoArg,		(caddr_t) "off"},
+#endif
 {"-tm",		"*ttyModes",	XrmoptionSepArg,	(caddr_t) NULL},
 {"-tn",		"*termName",	XrmoptionSepArg,	(caddr_t) NULL},
 {"-ut",		"*utmpInhibit",	XrmoptionNoArg,		(caddr_t) "on"},
@@ -387,7 +389,9 @@ static XrmOptionDescRec optionDescList[] = {
 {"+wf",		"*waitForMap",	XrmoptionNoArg,		(caddr_t) "off"},
 /* bogus old compatibility stuff for which there are
    standard XtInitialize options now */
+#ifndef HELIOS_VT_ONLY
 {"%",		"*tekGeometry",	XrmoptionStickyArg,	(caddr_t) NULL},
+#endif
 {"#",		".iconGeometry",XrmoptionStickyArg,	(caddr_t) NULL},
 {"-T",		"*title",	XrmoptionSepArg,	(caddr_t) NULL},
 {"-n",		"*iconName",	XrmoptionSepArg,	(caddr_t) NULL},
@@ -439,13 +443,17 @@ static struct _options {
 { "-/+si",                 "turn on/off scroll-on-tty-output inhibit" },
 { "-/+sk",                 "turn on/off scroll-on-keypress" },
 { "-sl number",            "number of scrolled lines to save" },
+#ifndef HELIOS_VT_ONLY
 { "-/+t",                  "turn on/off Tek emulation window" },
+#endif
 { "-tm string",            "terminal mode keywords and characters" },
 { "-tn name",              "TERM environment variable name" },
 { "-/+ut",                 "turn on/off utmp inhibit" },
 { "-/+vb",                 "turn on/off visual bell" },
 { "-e command args",       "command to execute" },
+#ifndef HELIOS_VT_ONLY
 { "%geom",                 "Tek window geometry" },
+#endif
 { "#geom",                 "icon window geometry" },
 { "-T string",             "title name for window" },
 { "-n string",             "icon name for window" },
@@ -742,7 +750,12 @@ char **argv;
 	inhibit = 0;
 	if (term->misc.logInhibit) 	    inhibit |= I_LOG;
 	if (term->misc.signalInhibit)		inhibit |= I_SIGNAL;
-	if (term->misc.tekInhibit)			inhibit |= I_TEK;
+	/* This native build has no Tektronix parser or graphics window. */
+#ifdef HELIOS_VT_ONLY
+        inhibit |= I_TEK;
+        screen->TekEmu = FALSE;
+#endif
+        if (term->misc.tekInhibit)			inhibit |= I_TEK;
 
 	term->initflags = term->flags;
 
@@ -847,9 +860,10 @@ char **argv;
 	XSetErrorHandler(xerror);
 	XSetIOErrorHandler(xioerror);
 	for( ; ; ) {
-		if(screen->TekEmu) {
-			TekRun();
-		} else
+#ifndef HELIOS_VT_ONLY
+		if(screen->TekEmu) TekRun();
+		else
+#endif
 			VTRun();
 	}
 }
