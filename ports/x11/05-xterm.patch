-#endif	/* DEBUG */
-	pid  = wait3 (&status, WNOHANG, (struct rusage *)NULL);
-	if (!pid) {
-#ifdef USE_SYSV_SIGNALS
-		(void) signal(SIGCHLD, reapchild);
-#endif /* USE_SYSV_SIGNALS */
-		SIGNAL_RETURN;
-	}
