    "revision": "793f7f4e147f3eb5172273818cf97a4d72f7bde0",
    "subdirectory": "mit",
    "tree_sha256": "9341a739994bb57e078eda4bf959fae2c24a965096a899e12906075039f9b7de"
  },
  "patches": [
    {
      "file": "01-platform.patch",
      "description": "Use Helios platform declarations in X clients and utilities",
      "sha256": "12af9e5881c264c8bca4d7250678fe2df61b249f1aeaa2f2de7dc2f4fe7cca80"
    },
    {
      "file": "02-cxx-headers.patch",
      "description": "Declare Xlib return types explicitly for C++ consumers",
      "sha256": "0142f124fcbb741413ea76a63bf3b388443c25a878ad113e70f3287b181e1c50"
    },
    {
      "file": "03-transport.patch",
      "description": "Adapt Xlib transport and authorization to Helios",
      "sha256": "40dee1e78e9aceb8b526232178b2d4f6ce324988ff5ec1b6bd03cc3c8e49bd17"
    },
    {
      "file": "04-widgets.patch",
      "description": "Adapt Xt and Xmu to the Helios compiler and runtime",
      "sha256": "6f302fab9087cba81748499dcea8b2e367e2ec73a8e493f460fb52a21c3473ac"
    },
    {
      "file": "05-xterm.patch",
      "description": "Connect xterm to the native terminal service and handle input and resize events",
      "sha256": "7776d26a44b68ca809cd094186bbb1f4028a0c77eb3ae3b43a403352f7365a6e"
    },
    {
      "file": "06-xdm.patch",
      "description": "Run XDM logins and display sessions as native Helios tasks, in the Helios desktop style",
      "sha256": "3cda48a90a276672ca9e814e90a24ad7721c2a3da9a5fed34c876963bae532a5"
    },
    {
      "file": "07-build-tools.patch",
      "description": "Build font utilities on the host and generate the twm fallback configuration",
      "sha256": "a44eae45325d3d35dc4148d11cd371b92b5a56ed2a1fa082da6423ac9beeec85"
    },
    {
      "file": "08-xterm-navigation.patch",
      "sha256": "58fe795adb8a6ff7072e2cecb852e3d7a3e4bb6839a345911f209d8d3e25d832",
      "description": "Keep Home and End outside the four-entry cursor-key table"
    },
    {
      "file": "09-xterm-fonts.patch",
      "description": "Pair normal and bold terminal fonts and reject incompatible bold font metrics",
      "sha256": "ac1910fd8545981796928fdb370d2a7d5b4574123b66a930a5c9f912f0ddc3f7"
    }
  ],
  "files": "files",
  "patched_tree_sha256": "01f5c929d47252a10ea92d2894f64c7f9665c652ceaa558ae29d210a7e065a97",
  "dependencies": [
    "xterm-tty"
  ],
