        "source": "${src}/include/bitmaps",
        "destination": "${work}/include/X11/bitmaps"
      },
      {
        "type": "glob-copy",
        "source": "${src}/lib/Xau",
        "pattern": "*.c",
        "destination": "${src}/lib/X"
      },
      {
        "type": "run",
        "command": [
          "bison",
          "-d",
          "-o",
          "gram.c",
          "gram.y"
        ],
        "cwd": "${src}/clients/twm"
      },
      {
        "type": "run",
        "command": [
          "flex",
          "-o",
          "lex.c",
          "lex.l"
        ],
        "cwd": "${src}/clients/twm"
      },
      {
        "type": "run",
        "command": [
          "${python}",
          "${src}/helios/generate-twm.py"
