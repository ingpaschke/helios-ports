        "-Wno-error=int-conversion",
        "-Wno-error=incompatible-pointer-types",
        "-Wno-error=return-mismatch",
        "-I${work}/include",
        "-I${work}/include/X11",
        "-I${work}/include/X11/extensions",
        "-I${src}",
        "-I${source_dir}",
        "-include",
        "${src}/helios/x11-platform.h"
      ]
    },
