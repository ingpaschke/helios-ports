 	if (BytesReadable(dpy->fd, (char *) &pend) < 0)
 	    _XIOError(dpy);
 
-        if (pend == 0) {
+        if (pend == 0
+#ifdef helios
+            /* Native stream sockets become pipes after Connect. RecvMessage
+             * (and MSG_PEEK) is only defined for Type_Socket streams. */
+            && (fdstream(dpy->fd)->Type & ~Type_Flags) == Type_Socket
+#endif
+           ) {
             char byte;
             int n, saved_errno = errno;
             do {
