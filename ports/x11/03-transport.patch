Subject: Adapt Xlib transport and authorization to Helios

diff --git a/lib/X/XlibInt.c b/lib/X/XlibInt.c
index dc97170b998b7e5c7685fb543dd3e1a324361fe6..4b595775eb0de21211689a07df36a95294bd5301 100644
--- a/lib/X/XlibInt.c
+++ b/lib/X/XlibInt.c
@@ -15,6 +15,7 @@
 #include <stdio.h>
 #include "Xlibint.h"
 #include "Xos.h"
+#include <sys/socket.h>
 
 static void _EatData32();
 
@@ -83,7 +84,7 @@ _XFlush (dpy)
 		todo = size;
 		bufindex += write_stat;
 #ifdef EWOULDBLOCK
-	    } else if (errno == EWOULDBLOCK) {
+	    } else if ((errno == EWOULDBLOCK || errno == EAGAIN)) {
 		_XWaitForWritable(dpy);
 #endif
 #ifdef SUNSYSV
@@ -125,6 +126,21 @@ _XEventsQueued (dpy, mode)
 	if (dpy->flags & XlibDisplayIOError) return(dpy->qlen);
 	if (BytesReadable(dpy->fd, (char *) &pend) < 0)
 	    _XIOError(dpy);
+
+        if (pend == 0) {
+            char byte;
+            int n, saved_errno = errno;
+            do {
+                n = recv(dpy->fd, &byte, 1, MSG_PEEK);
+            } while (n < 0 && errno == EINTR);
+            if (n == 0) {
+                errno = EPIPE;
+                _XIOError(dpy);
+            } else if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+                _XIOError(dpy);
+            }
+            errno = saved_errno;
+        }
 	if ((len = pend) < SIZEOF(xReply))
 	    return(dpy->qlen);	/* _XFlush can enqueue events */
 	else if (len > BUFSIZE)
@@ -217,7 +233,7 @@ _XRead (dpy, data, size)
 		    data += bytes_read;
 		    }
 #ifdef EWOULDBLOCK
-		else if (errno == EWOULDBLOCK) {
+		else if ((errno == EWOULDBLOCK || errno == EAGAIN)) {
 		    _XWaitForReadable(dpy);
 		    errno = 0;
 		}
@@ -408,7 +424,7 @@ _XReadPad (dpy, data, size)
 	    	    iov[0].iov_base += bytes_read;
 	    	}
 #ifdef EWOULDBLOCK
-	    else if (errno == EWOULDBLOCK) {
+	    else if ((errno == EWOULDBLOCK || errno == EAGAIN)) {
 		_XWaitForReadable(dpy);
 		errno = 0;
 	    }
@@ -508,7 +524,7 @@ _XSend (dpy, data, size)
 		total -= len;
 		todo = total;
 #ifdef EWOULDBLOCK
-	    } else if (errno == EWOULDBLOCK) {
+	    } else if ((errno == EWOULDBLOCK || errno == EAGAIN)) {
 #ifdef apollo /* stupid sr10.1 UDS bug - supposedly fixed in sr10.2 */
 		if (todo > 4096)
 		    todo = 4096;
@@ -1693,7 +1709,7 @@ int iovcnt;
 /*
 	END USER STAMP AREA
 */
-extern char * malloc();
+
 extern char _XsTypeOfStream[];
 extern Xstream _XsStream[];
 
