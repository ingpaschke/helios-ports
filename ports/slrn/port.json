    "sha256": "3ba8a4d549201640f2b82d53fb1bec1250f908052a7983f0061c983c634c2dac",
    "subdirectory": "slrn-1.0.3",
    "tree_sha256": "9df30e09fe210dc26a69ab1ad9c2d6b15f7376ef66216ebcf0661a980484a781"
  },
  "patches": [
    {
      "file": "01-runtime.patch",
      "description": "Adapt terminal input, locking and task execution to Helios",
      "sha256": "8bddea64c11b68e897c24af35cdf2c3547d85631948d24a5824e719dada774b6"
    },
    {
      "file": "02-network.patch",
      "description": "Use native socket readiness, name resolution and TLS",
      "sha256": "50ade12b7815c4f01a2e9c6b37ddb1a7cdcf5b322809a8dc7e9b7ab684218e08"
    },
    {
      "file": "03-configuration.patch",
      "sha256": "a4e02161597b353ff7630cdcd7dbdea585fbb4b5736c5e65fe5f5babaeb57bda",
      "description": "Select supported features and install newsreader defaults"
    }
  ],
  "files": "files",
  "patched_tree_sha256": "9313a27eaa783c4787ca361f63e3f327f139ce03d959fea75cf58c9996d97a8a",
  "dependencies": [
    "slang",
    "ncurses"
  ],
  "requires_compat": true,
  "host_tools": [],
  "build": {
    "compile": {
      "flags": [
        "-std=gnu99",
        "-D_BSD",
        "-D__HELIOS",
        "-D__TRAN",
        "-D__HELIOSTRAN",
        "-Dunix",
        "-D__unix__",
        "-DHAVE_CONFIG_H",
        "-DSLANG_INSTALL_PREFIX=\"/helios/local\"",
        "-DSLRN_SLANG_DIR=\"/helios/local/share/slrn/macros\"",
        "-DSLRN_LIB_DIR=\"/helios/local/share/slrn\"",
        "-DSLRN_CONF_DIR=\"/helios/etc\"",
        "-DNLS_LOCALEDIR=\"/helios/local/share/locale\"",
        "-Wno-error=implicit-function-declaration",
        "-Wno-error=int-conversion",
        "-Wno-error=incompatible-pointer-types",
        "-I${source_dir}",
        "-I${src:slang}/src",
        "-I${src}/src",
        "-I${src}/helios",
        "-I${compat}/include/helios-unix",
        "-include",
        "${src}/helios/platform.h"
      ]
    },
    "groups": [
      {
