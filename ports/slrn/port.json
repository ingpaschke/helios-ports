      {
        "name": "probe",
        "sources": [
          "${src}/helios/platform-probe.c",
          "${src}/helios/platform.c"
        ]
      }
    ],
    "link": {
      "libraries": [
        "${compat}/lib/helios-unix.lib",
        "${sdk}/lib/bsd.lib",
        "${sdk}/lib/c.lib",
        "${sdk}/lib/helios.lib",
        "${runtime}"
      ]
    },
    "targets": [
      {
        "name": "slrn",
        "type": "executable",
        "groups": [
          "slrn"
        ],
        "output": "${stage}/local/bin/slrn",
        "stack": 262144,
        "heap": 1048576
      },
      {
        "name": "slrn-probe",
        "type": "executable",
        "groups": [
          "probe"
        ],
        "output": "${work}/platform-probe",
        "stack": 32768,
        "heap": 32768
      }
    ],
    "install": [
      {
        "type": "copy",
        "source": "${src}/helios/slrn.rc",
        "destination": "${stage}/etc/slrn.rc"
      },
      {
        "type": "copy",
        "source": "${src}/doc/help.txt",
        "destination": "${stage}/etc/help.txt"
      },
      {
        "type": "copy",
        "source": "${src}/helios/README.txt",
        "destination": "${stage}/local/share/slrn/README.txt"
      },
      {
        "type": "copy",
        "source": "${src}/macros",
        "destination": "${stage}/local/share/slrn/macros"
      },
      {
        "type": "copy",
        "source": "${src}/doc/slrn.rc",
        "destination": "${stage}/local/share/slrn/sample.slrnrc"
      },
      {
        "type": "copy",
        "source": "${src}/doc",
        "destination": "${stage}/local/share/slrn/doc"
      },
      {
        "type": "copy",
        "source": "${src}/COPYING",
        "destination": "${stage}/local/share/slrn/COPYING.slrn"
      },
      {
        "type": "copy",
        "source": "${src:slang}/COPYING",
        "destination": "${stage}/local/share/slrn/COPYING.slang"
      },
      {
        "type": "copy",
        "source": "${src}/COPYRIGHT",
        "destination": "${stage}/local/share/slrn/COPYRIGHT.slrn"
      }
    ]
